{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ts-node --project tsconfig.json src/main.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start:prod": "node dist/backend/src/main.js",
    "test": "ts-node --project tsconfig.json test/run.ts && ts-node --project tsconfig.json test/unit.ts",
    "test:sample": "ts-node --project tsconfig.json test/sample.ts",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node --project tsconfig.json prisma/seed.ts",
    "db:test:prepare": "ts-node --project tsconfig.json scripts/test-db.ts",
    "test:db": "npm run db:test:prepare && ts-node --project tsconfig.json test/db.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "prisma": "7.10.1",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
