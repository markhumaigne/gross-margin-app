# Supabase dashboard > Connect > Transaction pooler (port 6543). Used by the running API.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase dashboard > Connect > Session pooler or Direct connection (port 5432). Used by the Prisma CLI and scripts.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Your own secret for signing sign-in tokens: at least 32 random characters (for example from openssl rand -base64 48).
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Same as DATABASE_URL plus schema=test. Tests only ever touch this schema, never "public".
TEST_DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=test"
# Same as DIRECT_URL plus schema=test. Used to create and migrate the test schema.
TEST_DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=test"
